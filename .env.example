# Copy to ".env" in this directory (already gitignored) and fill in values.
# Then run: npm run build:signed
#
# APPLE_PASSWORD must be an app-specific password from https://appleid.apple.com
# (not your normal Apple ID password).
#
# APPLE_TEAM_ID: 10-character Team ID from Membership Details (same as in parentheses
# on your "Developer ID Application: … (TEAMID)" signing identity).
#
# APPLE_SIGNING_IDENTIT is the name of your Apple code signing certificate used for distributing macOS apps outside the App Store.
# Find your exact identity string by running this command in your Mac terminal:
# `security find-identity -v -p codesigning`
# Example: "Developer ID Application: Your Company, Inc. (TEAMID1234)"

APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
APPLE_SIGNING_IDENTITY=
