{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoSuite",
  "version": "0.9.8",
  "identifier": "app.photosuite",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PhotoSuite",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "devtools": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Photography",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "Developer ID Application: Patrik Ohlson (W3H3H7D9ST)",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 200,
          "y": 120
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "psd",
          "psb"
        ],
        "name": "Photoshop Document",
        "description": "Layered image document",
        "role": "Editor",
        "mimeType": "image/vnd.adobe.photoshop"
      },
      {
        "ext": ["png"],
        "name": "PNG Image",
        "description": "Bitmap image",
        "role": "Editor",
        "mimeType": "image/png"
      },
      {
        "ext": ["jpg", "jpeg"],
        "name": "JPEG Image",
        "description": "Bitmap image",
        "role": "Editor",
        "mimeType": "image/jpeg"
      },
      {
        "ext": ["gif"],
        "name": "GIF Image",
        "description": "Bitmap image",
        "role": "Editor",
        "mimeType": "image/gif"
      },
      {
        "ext": ["webp"],
        "name": "WebP Image",
        "description": "Bitmap image",
        "role": "Editor",
        "mimeType": "image/webp"
      },
      {
        "ext": ["avif"],
        "name": "AVIF Image",
        "description": "Bitmap image",
        "role": "Editor",
        "mimeType": "image/avif"
      },
      {
        "ext": ["heic"],
        "name": "HEIC Image",
        "description": "Bitmap image",
        "role": "Editor",
        "mimeType": "image/heic"
      },
      {
        "ext": ["heif"],
        "name": "HEIF Image",
        "description": "Bitmap image",
        "role": "Editor",
        "mimeType": "image/heif"
      },
      {
        "ext": ["bmp"],
        "name": "Bitmap Image",
        "description": "Bitmap image",
        "role": "Editor",
        "mimeType": "image/bmp"
      },
      {
        "ext": ["tif", "tiff"],
        "name": "TIFF Image",
        "description": "Bitmap image",
        "role": "Editor",
        "mimeType": "image/tiff"
      },
      {
        "ext": ["ico"],
        "name": "Icon",
        "description": "Bitmap image",
        "role": "Editor",
        "mimeType": "image/vnd.microsoft.icon"
      },
      {
        "ext": ["svg"],
        "name": "SVG Document",
        "description": "Vector or page document",
        "role": "Editor",
        "mimeType": "image/svg+xml"
      },
      {
        "ext": ["ai", "eps", "ps"],
        "name": "PostScript Document",
        "description": "Vector or page document",
        "role": "Editor",
        "mimeType": "application/postscript"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Vector or page document",
        "role": "Editor",
        "mimeType": "application/pdf"
      },
      {
        "ext": ["dxf"],
        "name": "DXF Document",
        "description": "Vector or page document",
        "role": "Editor",
        "mimeType": "image/vnd.dxf"
      },
      {
        "ext": ["emf"],
        "name": "EMF Document",
        "description": "Vector or page document",
        "role": "Editor",
        "mimeType": "image/x-emf"
      },
      {
        "ext": ["wmf"],
        "name": "WMF Document",
        "description": "Vector or page document",
        "role": "Editor",
        "mimeType": "image/wmf"
      },
      {
        "ext": ["cdr"],
        "name": "CorelDRAW Document",
        "description": "Vector or page document",
        "role": "Editor",
        "mimeType": "application/octet-stream"
      },
      {
        "ext": [
          "sketch",
          "xd",
          "fig",
          "af",
          "afdesign",
          "afphoto",
          "afpub",
          "aftemplate",
          "xcf",
          "ora",
          "clip"
        ],
        "name": "Design Document",
        "description": "Layered design document",
        "role": "Editor",
        "mimeType": "application/octet-stream"
      },
      {
        "ext": [
          "exr",
          "hdr",
          "dds",
          "tga",
          "ppm",
          "pgm",
          "pbm",
          "pnm",
          "lif",
          "fits",
          "fit",
          "fts",
          "raf",
          "cr2",
          "cr3",
          "crw",
          "nef",
          "nrw",
          "arw",
          "dng",
          "orf",
          "rw2",
          "pef",
          "srw",
          "raw",
          "iff",
          "lbm"
        ],
        "name": "Image Data",
        "description": "High dynamic range or raw image data",
        "role": "Editor",
        "mimeType": "application/octet-stream"
      }
    ]
  }
}
